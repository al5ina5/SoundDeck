#!/var/jb/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
  su mobile -c '/var/jb/usr/bin/sdctl cc-dismiss' 2>/dev/null || true
  su mobile -c '/var/jb/usr/bin/sdctl cc-remove' 2>/dev/null || true
fi
mkdir -p /var/jb/var/lib/sounddeck
chmod 700 /var/jb/var/lib/sounddeck
if su mobile -c '/var/jb/usr/bin/sdctl is-disabled'; then
  rm -f /var/jb/var/lib/sounddeck/re-enable
else
  touch /var/jb/var/lib/sounddeck/re-enable
fi
# First restore original gains while service and injection are still present.
su mobile -c '/var/jb/usr/bin/sdctl disable' 2>/dev/null || true
sleep 2
for domain in system user/501; do
  launchctl bootout "$domain/com.alsinas.sounddeck" 2>/dev/null || true
done
exit 0
